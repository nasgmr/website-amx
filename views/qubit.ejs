<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Qubit - AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="homepage-body">
    <%- include('partials/navbar') %>

    <main class="detail-container">

        <section class="detail-header">
            <h4 class="product-category">DIY Drone for Students & Hobbyist</h4>
            <h1 class="product-title glowing-text">QUBIT</h1>
        </section>

        <div class="detail-grid">
            <div class="detail-image-box">
                <p>FOTO PRODUK QUBIT</p>
            </div>

            <div class="detail-description">
                <p>Qubit is a DIY drone designed for students and hobbyists. It is easy to assemble, fully customizable, and perfect for learning about drone technology and flight dynamics.</p>
                
                <div class="specs-grid">
        <div class="spec-item">
            <h3>Dimension</h3>
            <ul>
                <li>Wingspan: 1400 mm</li>
                <li>Length: 470 mm</li>
                <li>Height: 450 mm</li>
                <li>Weight: 2700 gr</li>
            </ul>
        </div>
        <div class="spec-item">
            <h3>Battery</h3>
            <ul>
                <li>LIPO: 88WH</li>
                <li>Weight: 470 gr</li>
                <li>Charge: 1-2 Hr</li>
            </ul>
        </div>
        <div class="spec-item">
            <h3>Material</h3>
            <p>Fiber Composites</p>
        </div>
        <div class="spec-item">
            <h3>Controller</h3>
            <p>High Precision Autopilot</p>
        </div>
        
        <div class="spec-item full-width">
            <h3>Propulsion</h3>
            <p>Brushless Motor & Carbon Propeller</p>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>

</html>
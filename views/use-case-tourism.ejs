<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Use Case - Tourism | AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="homepage-body">

    <%- include('partials/navbar') %>

    <main class="use-case-container">
        <h4 class="use-case-label">USE CASE</h4>

        <nav class="sub-nav">
            <a href="/resources/use-case/infrastructure" class="active">INFRASTRUCTURE M.</a>
            <a href="/resources/use-case/tourism">TOURISM PROMO</a>
            <a href="/resources/use-case/agri-forest">AGRICULTURE & FOREST</a>
            <a href="/resources/use-case/agri-plant">AGRICULTURE & PLANTATION</a>
        </nav>

        <h1 class="category-main-title">INFRASTRUCTURE MONITORING & PLANNING</h1>

        <div class="case-grid">
            
            <div class="case-card">
                <div class="case-image-box">
                    <span>IMAGE</span> 
                </div>
                <div class="case-details">
                    <h3>Land Use and Industrial Site Planning</h3>
                    <div class="specs-mini-grid">
                        <div class="spec-group">
                            <label>Location</label>
                            <p>Batam, Indonesia</p>
                        </div>
                        <div class="spec-group">
                            <label>Total Area</label>

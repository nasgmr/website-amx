<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Use Case - Tourism | AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const plane = document.getElementById("paperPlane");
        if (!plane) return;

        const urlParams = new URLSearchParams(window.location.search);
        const direction = urlParams.get('fly'); 

        const isMobile = window.innerWidth <= 768;
        
        const flyRight = isMobile ? [
            { transform: 'translate(-100px, 30px) rotate(15deg)', opacity: 1 },
            { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5 }
        ] : [
            { transform: 'translate(-150px, 30px) rotate(15deg)', opacity: 0, offset: 0 },
            { opacity: 1, offset: 0.1 },
            { opacity: 1, offset: 0.9 },
            { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5, offset: 1 }
        ];

        const flyLeft = isMobile ? [
            { transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 1 },
            { transform: 'translate(-100px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5 }
        ] : [
            { transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 0, offset: 0 },
            { opacity: 1, offset: 0.1 },
            { opacity: 1, offset: 0.9 },
            { transform: 'translate(-150px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5, offset: 1 }
        ];

        const timing = { duration: 1500, easing: 'cubic-bezier(0.25, 1, 0.5, 1)', fill: 'forwards' };

        setTimeout(() => {
            if (direction === 'left') {
                plane.animate(flyLeft, timing);
            } else {
                plane.animate(flyRight, timing); 
            }
        }, 50);

        const contentContainers = document.querySelectorAll(".dronepedia-content, .case-grid, .portfolio-list, .products-container");
        const mainContent = contentContainers.length > 0 ? contentContainers[0] : null;

        if (mainContent) {
            if (mainContent) {
                const dragLeftAnim = [
                    { transform: 'translateX(100vw) scale(0.9) skewX(-5deg)', opacity: 0 },
                    { transform: 'translateX(-20px) scale(1.02) skewX(2deg)', opacity: 1, offset: 0.8 },
                    { transform: 'translateX(0) scale(1) skewX(0deg)', opacity: 1 }
                ];

                const dragRightAnim = [
                    { transform: 'translateX(-100vw) scale(0.9) skewX(5deg)', opacity: 0 },
                    { transform: 'translateX(20px) scale(1.02) skewX(-2deg)', opacity: 1, offset: 0.8 },
                    { transform: 'translateX(0) scale(1) skewX(0deg)', opacity: 1 }
                ];

                const elementsToAnimate = document.querySelectorAll(".category-main-title, .dronepedia-content, .case-grid, .portfolio-list, .products-container, .product-card");
        
                elementsToAnimate.forEach(el => {
                    if (direction === 'left') {
                        el.animate(dragLeftAnim, timing);
                    } else {
                        el.animate(dragRightAnim, timing);
                    }
                });
            }
        }

        const order = ['infrastructure', 'tourism', 'agri-forest', 'agri-plant'];
        const currentPath = window.location.pathname.toLowerCase();
        let currentIndex = order.findIndex(id => currentPath.includes(id));
        if(currentIndex === -1) currentIndex = 0;

        const links = document.querySelectorAll('a');
        links.forEach(link => {
            link.addEventListener('click', function(e) {
                let targetHref = this.getAttribute('href');
                if(!targetHref) return;
                
                let cleanHref = targetHref.split('?')[0];
                let targetIndex = order.findIndex(id => cleanHref.toLowerCase().includes(id));
                
                if (targetIndex !== -1 && cleanHref.includes('/use-case/')) {
                    e.preventDefault();
                    let flyParam = (targetIndex < currentIndex) ? 'left' : 'right';
                    window.location.href = cleanHref + "?fly=" + flyParam;
                }
            });
        });
    });
</script>

<body class="homepage-body">
    <%- include('partials/navbar') %>

    <main class="use-case-container">
        <img src="/img/DRONE - ANIMATION.png" id="paperPlane" class="flying-plane" alt="Flying Plane">

        <div class="use-case-header-section">
            <h4 class="use-case-label">USE CASE</h4>
            
            <nav class="sub-nav">
                <a href="/use-case/infrastructure">INFRASTRUCTURE MONITORING</a>
                <a href="/use-case/tourism" class="active">TOURISM PROMOTION</a>
                <a href="/use-case/agri-forest">AGRICULTURE & FOREST</a>
                <a href="/use-case/agri-plant">AGRICULTURE & PLANTATION</a>
            </nav>

            <h1 class="category-main-title">TOURISM PROMOTION & MINING INVENTORY</h1>
        </div>

        <div class="case-grid">
            
            <div class="case-item">
                <h3 class="project-title">Virtual Reality For Tourism Promotion</h3>
                <img src="/img/Use Case - Virtual Reality.png" style="width: 100%; max-width: 400px; height: auto; display: block; margin: 8px auto 30px auto; border-radius: 8px;">
                
                <div class="case-stats-grid">
                    <div class="stat-item"><label>Location</label><span>Flores, Indonesia</span></div>
                    <div class="stat-item"><label>Total Area</label><span>1000Ha</span></div>
                    <div class="stat-item"><label>Altitude</label><span>200m</span></div>
                    <div class="stat-item"><label>Drone</label><span>AMX Vertic</span></div>
                    <div class="stat-item"><label>GSD</label><span>7cm/pixel</span></div>
                </div>
            </div>

            <div class="case-item">
                <h3 class="project-title">Nickel Mine Site Inventory</h3>
                <img src="/img/Use Case - Nickel Mine.png" style="width: 100%; max-width: 400px; height: auto; display: block; margin: 8px auto 30px auto; border-radius: 8px;">
                
                <div class="case-stats-grid">
                    <div class="stat-item"><label>Location</label><span>Kolaka, Indonesia</span></div>
                    <div class="stat-item"><label>Total Area</label><span>7000Ha</span></div>
                    <div class="stat-item"><label>Altitude</label><span>250m</span></div>
                    <div class="stat-item"><label>Drone</label><span>AMX Vertic</span></div>
                    <div class="stat-item"><label>GSD</label><span>7cm/pixel</span></div>
                </div>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
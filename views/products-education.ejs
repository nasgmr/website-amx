<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Education Drones - AMX UAV</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const plane = document.getElementById("paperPlane");
        if (!plane) return;

        const urlParams = new URLSearchParams(window.location.search);
        const direction = urlParams.get('fly'); 
        const isMobile = window.innerWidth <= 768;
        const timing = { duration: 1500, easing: 'cubic-bezier(0.25, 1, 0.5, 1)', fill: 'forwards' };

        // 1. Animasi Pesawat
        const flyRight = isMobile ? 
            [{ transform: 'translate(-100px, 30px) rotate(15deg)', opacity: 1 }, { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5 }] : 
            [{ transform: 'translate(-150px, 30px) rotate(15deg)', opacity: 0, offset: 0 }, { opacity: 1, offset: 0.1 }, { opacity: 1, offset: 0.9 }, { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5, offset: 1 }];

        const flyLeft = isMobile ? 
            [{ transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 1 }, { transform: 'translate(-100px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5 }] : 
            [{ transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 0, offset: 0 }, { opacity: 1, offset: 0.1 }, { opacity: 1, offset: 0.9 }, { transform: 'translate(-150px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5, offset: 1 }];

        setTimeout(() => {
            direction === 'left' ? plane.animate(flyLeft, timing) : plane.animate(flyRight, timing);
        }, 50);

        // 2. LOGIKA UTAMA (Sesuai Referensi Portfolio)
        // Targetkan kontainer list produk
        const contentContainers = document.querySelectorAll(".product-list");
        const mainContent = contentContainers.length > 0 ? contentContainers[0] : null;

        if (mainContent) {
            const dragLeftAnim = [{ transform: 'translateX(100vw) scale(0.9) skewX(-5deg)', opacity: 0 }, { transform: 'translateX(-20px) scale(1.02) skewX(2deg)', opacity: 1, offset: 0.8 }, { transform: 'translateX(0) scale(1) skewX(0deg)', opacity: 1 }];
            const dragRightAnim = [{ transform: 'translateX(-100vw) scale(0.9) skewX(5deg)', opacity: 0 }, { transform: 'translateX(20px) scale(1.02) skewX(-2deg)', opacity: 1, offset: 0.8 }, { transform: 'translateX(0) scale(1) skewX(0deg)', opacity: 1 }];

            // Daftarkan elemen yang mau digerakkan
            // JANGAN masukkan .products-container agar judul dan navigasi tetap diam
            const elementsToAnimate = document.querySelectorAll(".product-list, .drone-usage-section");
            
            elementsToAnimate.forEach(el => {
                if (direction === 'left') {
                    el.animate(dragLeftAnim, timing);
                } else {
                    // DEFAULT ANIMATION: Jalan saat diklik dari navbar (fly = null)
                    el.animate(dragRightAnim, timing); 
                }
            });
        }

        // 3. Logika Navigasi Sub-Tab
        const order = ['mapping', 'education'];
        const currentPath = window.location.pathname.toLowerCase();
        let currentIndex = order.findIndex(id => currentPath.includes(id));
        if(currentIndex === -1) currentIndex = 0;

        document.querySelectorAll('.sub-nav a').forEach(link => {
            link.addEventListener('click', function(e) {
                const targetHref = this.getAttribute('href');
                if (targetHref && targetHref.includes('/products/')) {
                    e.preventDefault();
                    const cleanHref = targetHref.split('?')[0];
                    const targetIndex = order.findIndex(id => cleanHref.toLowerCase().includes(id));
                    const flyParam = (targetIndex < currentIndex) ? 'left' : 'right';
                    window.location.href = cleanHref + "?fly=" + flyParam;
                }
            });
        });
    });
</script>

<body class="homepage-body"> 
    <%- include('partials/navbar') %>

    <main class="products-container">
        <img src="/img/DRONE - ANIMATION.png" id="paperPlane" class="flying-plane" alt="Flying Plane">
        
        <div class="products-header-section" style="text-align: center; margin-bottom: -20px;">
            <h4 class="products-label">OUR PRODUCTS</h4>
            <nav class="sub-nav" style="justify-content: center; display: flex;">
                <a href="/products/mapping" class="<%= active === 'mapping' ? 'active' : '' %>">MAPPING DRONE</a>
                <a href="/products/education" class="<%= active === 'education' ? 'active' : '' %>">EDUCATION DRONE</a>
            </nav>
        </div>

        <section class="product-list">
            <div class="product-card">
                <div class="product-image-box">
                    <p>FOTO PRODUK</p>
                </div>
                <div class="product-info">
                    <h4 class="product-category">DIY Drone for Students & Hobbyist</h4>
                    <h1 class="product-title glowing-text">QUBIT</h1>
                    <p>Qubit is a mini quad copter type drone. Design for students (10 years+) and drone hobbyist. Perfect for learn how to build, coding, and operate a drone.</p>
                    <a href="/products/qubit" class="btn-learn-more-products">Click Here For More</a>
                </div>
            </div>
        </section>

        <section class="drone-usage-section">
            <h1 class="usage-title glowing-text">HOW TO USE DRONE TECHNOLOGY?</h1>
            <p class="usage-subtitle">AMX UAV offer 2 options for using Drone technology:</p>
            <div class="usage-options">
                <div class="usage-box">
                    <h4 style="font-size: 25px; margin-bottom: 15px" margin-bottom="10px">Buy and Operate UAV/Drones Independently</h4>
                    <ul>
                        <li>Suitable for objects that need updates periodically: Agriculture/plantation/forestry monitoring, Media reportation (video/picture), Construction/Infrastructure project report, Survey & disaster mitigation</li>
                        <li>Accumulatively, for the long term costs UAV/Drone team production (operational, maintenance, etc.) more economical</li>
                        <li>AMX UAV ready to be your partner for UAV sales, operator training, and maintenance</li>
                    </ul>
                </div>

                <div class="usage-box">
                    <h4 style="font-size: 25px; margin-bottom: 15px" margin-bottom="10px">Utilize AMX UAV Professional Services</h4>
                    <ul>
                        <li>Suitable for objects that don't need high intensity updates</li>
                        <li>Documentation & sites/building modeling</li>
                        <li>Profile & area planning, Event documentation, Advertisement</li>
                        <li>There is no routine cost for the UAV/Drone team (operational, maintenance, etc.) when not producing</li>
                        <li>Integrated data processing & editing</li>
                        <li>AMX UAV experience for the best results</li>
                    </ul>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Partners & Clients - AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="homepage-body">
    <main class="use-case-container partners-container">

        <div class="use-case-header-section partners-header">
            <h1 class="category-main-title">PARTNERS & CLIENTS</h1>
        </div>

        <div class="partners-grid">
            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/logo-ugm.png" alt="UGM Logo">
                </div>
                <h4 style="font-size: 16px; color: #ffffff">UGM</h4>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/logo-brin.png" alt="BRIN Logo">
                </div>
                <h4 style="font-size: 16px; color: #ffffff">BRIN</h4>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/logo-kemdikbud.png" alt="KEMDIKBUD Logo">
                </div>
                <h4 style="font-size: 16px; color: #ffffff">KEMDIKBUD</h4>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/logo-big.png" alt="BIG Logo">
                </div>
                <h4 style="font-size: 16px; color: #ffffff">BIG</h4>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/logo-beehive.png" alt="Beehive Drone Logo">
                </div>
                <h4 style="font-size: 16px; color: #ffffff">BEEHIVE DRONE</h4>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/logo-mitrageotama.png" alt="Mitra Geotama Logo">
                </div>
                <h4 style="font-size: 16px; color: #ffffff">MITRA GEOTAMA</h4>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/logo-tni.png" alt="TNI AU Logo">
                </div>
                <h4 style="font-size: 16px; color: #ffffff">TNI AU</h4>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
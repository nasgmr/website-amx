<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Partners & Clients - AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="homepage-body">
    <%- include('partials/navbar') %>

    <main class="use-case-container partners-container">

        <div class="use-case-header-section partners-header">
            <h1 class="category-main-title">PARTNERS & CLIENTS</h1>
        </div>

        <div class="partners-grid">
            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/Lambang UGM.png" alt="UGM Logo">
                </div>
                <h3>UGM</h3>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/brin.png" alt="BRIN Logo">
                </div>
                <h3>BRIN</h3>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/Logo_of_Ministry_of_Education_and_Culture_of_Republic_of_Indonesia.svg.png" alt="KEMDIKBUD Logo">
                </div>
                <h3>KEMDIKBUD</h3>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/Logo_Badan_Informasi_Geospasial.png" alt="BIG Logo">
                </div>
                <h3>BIG</h3>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/Beehive.png" alt="Beehive Drone Logo">
                </div>
                <h3>BEEHIVE DRONE</h3>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/mitrageotama1-300x221.png" alt="Mitra Geotama Logo">
                </div>
                <h3>MITRA GEOTAMA</h3>
            </div>

            <div class="partner-card">
                <div class="partner-logo-box">
                    <img src="/img/Lambang_TNI_AU.png" alt="TNI AU Logo">
                </div>
                <h3>TNI AU</h3>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio 2024 - AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const plane = document.getElementById("paperPlane");
        if (!plane) return;

        const urlParams = new URLSearchParams(window.location.search);
        const direction = urlParams.get('fly'); 
        const isMobile = window.innerWidth <= 768;
        const timing = { duration: 1500, easing: 'cubic-bezier(0.25, 1, 0.5, 1)', fill: 'forwards' };

        const flyRight = isMobile ? 
            [{ transform: 'translate(-100px, 30px) rotate(15deg)', opacity: 1 }, { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5 }] : 
            [{ transform: 'translate(-150px, 30px) rotate(15deg)', opacity: 0, offset: 0 }, { opacity: 1, offset: 0.1 }, { opacity: 1, offset: 0.9 }, { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5, offset: 1 }];

        const flyLeft = isMobile ? 
            [{ transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 1 }, { transform: 'translate(-100px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5 }] : 
            [{ transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 0, offset: 0 }, { opacity: 1, offset: 0.1 }, { opacity: 1, offset: 0.9 }, { transform: 'translate(-150px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5, offset: 1 }];

        setTimeout(() => {
            direction === 'left' ? plane.animate(flyLeft, timing) : plane.animate(flyRight, timing);
        }, 50);

        const contentContainers = document.querySelectorAll(".portfolio-list");
        const mainContent = contentContainers.length > 0 ? contentContainers[0] : null;

        if (mainContent) {
            const dragLeftAnim = [{ transform: 'translateX(100vw) scale(0.9) skewX(-5deg)', opacity: 0 }, { transform: 'translateX(-20px) scale(1.02) skewX(2deg)', opacity: 1, offset: 0.8 }, { transform: 'translateX(0) scale(1) skewX(0deg)', opacity: 1 }];
            const dragRightAnim = [{ transform: 'translateX(-100vw) scale(0.9) skewX(5deg)', opacity: 0 }, { transform: 'translateX(20px) scale(1.02) skewX(-2deg)', opacity: 1, offset: 0.8 }, { transform: 'translateX(0) scale(1) skewX(0deg)', opacity: 1 }];

            const elementsToAnimate = document.querySelectorAll(".portfolio-list");
            
            elementsToAnimate.forEach(el => {
                if (direction === 'left') {
                    el.animate(dragLeftAnim, timing);
                } else {
                    el.animate(dragRightAnim, timing); 
                }
            });
        }

        const order = ['2018', '2019', '2020', '2021', '2022', '2023', '2024', '2025'];
        const currentPath = window.location.pathname.toLowerCase();
        let currentIndex = order.findIndex(id => currentPath.includes(id));
        if(currentIndex === -1) currentIndex = 0;

        document.querySelectorAll('.timeline-nav a').forEach(link => {
            link.addEventListener('click', function(e) {
                const targetHref = this.getAttribute('href');
                if (targetHref && targetHref.includes('/portfolio/')) {
                    e.preventDefault();
                    const cleanHref = targetHref.split('?')[0];
                    const targetYearMatch = cleanHref.match(/\/portfolio\/(\d{4})/);
                    const targetYear = targetYearMatch ? targetYearMatch[1] : null;
                    const targetIndex = order.indexOf(targetYear);
                    const flyParam = (targetIndex < currentIndex) ? 'left' : 'right';
                    window.location.href = cleanHref + "?fly=" + flyParam;
                }
            });
        });
    });
</script>

<body class="homepage-body portfolio-page">
    <main class="portfolio-container">
        <img src="/img/DRONE - ANIMATION.png" id="paperPlane" class="flying-plane" alt="Flying Plane">

        <div class="portfolio-header">
            <h1 class="category-main-title">PORTFOLIO</h1> 
        </div>

        <div class="timeline-nav">
            <a href="/about-us/portfolio/2018" class="<%= active === '2018' ? 'active-year' : '' %>">2018</a>
            <a href="/about-us/portfolio/2019" class="<%= active === '2019' ? 'active-year' : '' %>">2019</a>
            <a href="/about-us/portfolio/2020" class="<%= active === '2020' ? 'active-year' : '' %>">2020</a>
            <a href="/about-us/portfolio/2021" class="<%= active === '2021' ? 'active-year' : '' %>">2021</a>
            <a href="/about-us/portfolio/2022" class="<%= active === '2022' ? 'active-year' : '' %>">2022</a>
            <a href="/about-us/portfolio/2023" class="<%= active === '2023' ? 'active-year' : '' %>">2023</a>
            <a href="/about-us/portfolio/2024" class="<%= active === '2024' ? 'active-year' : '' %>">2024</a>
            <a href="/about-us/portfolio/2025" class="<%= active === '2025' ? 'active-year' : '' %>">2025</a>
        </div>

        <div class="portfolio-list">
            <div class="portfolio-item">
                <p>Augmented Reality Drone Assisted Scouting, Indonesian Ministry of Education and Culture-UGM</p> 
            </div>
            <div class="portfolio-item">
                <p>Agri Watch Net, Indonesian Ministry of Education and Culture-UGM</p> 
            </div>
            <div class="portfolio-item">
                <p>Multi UAV Development, Indonesia, Indonesian Ministry of Education and Culture-Universitas Negeri Yogyakarta</p> 
            </div>
            <div class="portfolio-item">
                <p>Vertic Block III VTOL Drone Procurement, Indonesia, Universitas Negeri Yogayakarta</p> 
            </div>
            <div class="portfolio-item">
                <p>Vertic Block III VTOL Drone Procurement, Indonesia, KJSB Pandu Arsa</p> 
            </div>
            <div class="portfolio-item">
                <p>Kampung Gunung Development Aerial Mapping, PT Tanivest Agro Development</p> 
            </div>
            <div class="portfolio-item">
                <p>Vertic XL VTOL Drone Development, Indonesia Research and Innovation Board (BRIN)</p> 
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vertic Air - AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="homepage-body">

    <%- include('partials/navbar') %>

    <main class="detail-container">

        <section class="detail-header">
            <h4 class="product-category">Compact eVTOL Drone</h4>
            <h1 class="product-title glowing-text">VERTIC AIR</h1>
        </section>

        <div class="detail-grid">
            <div class="detail-image-box">
                <p>FOTO PRODUK VERTIC AIR</p>
            </div>

            <div class="detail-description">
                <p>Vertic Air is easy to control, fully autonomous, and capable to operate from narrow vertical take off-landing (VTOL) mapping drone. Vertic air is ready for various application such as agriculture, asset monitoring, construction & engineering planning, and military surveillance.</p>
                
                <div class="specs-grid">
                    
                    <div class="spec-item">
                        <h3>Dimension</h3>
                        <ul>
                            <li>Wingspan: 1400 mm</li>
                            <li>Length: 470 mm</li>
                            <li>Height: 450 mm</li>
                            <li>Weight: 2700 gr</li>
                        </ul>
                    </div>
                    
                    <div class="spec-item">
                        <h3>Battery</h3>
                        <ul>
                            <li>LIPO: 88WH</li>
                            <li>Weight: 470 gr</li>
                            <li>Charge: 1-2 Hr</li>
                        </ul>
                    </div>

                    <div class="spec-item full-width">
                        <h3>Material</h3>
                        <p>Fiber Composites</p>
                    </div>

                </div> 
            </div> 
        </div> 

        <section class="additional-info">
            <div class="info-box">
                <h3>Payloads</h3>
                <ul>
                    <li>C1: 24MP, APS-C Sensor, 20mm Wide Lens, PPK Ready</li>
                    <li>MicaSense RedEdge-P: 5.1MP Panchromatic, 5 Band</li>
                    <li>ADTI 265 V2: 26MP, APS-C Sensor, 16mm Wide Lens, PPK Ready</li>
                    <li>M2D: Day/IR, 6x zoom, Target Track, Stabilized</li>
                </ul>
            </div>

            <div class="info-box">
                <h3>Applications & Training</h3>
                <ul>
                    <li>Precision Agriculture & Asset Monitoring</li>
                    <li>Military Surveillance</li>
                    <li>Basic Hybrid Drone Operator Training</li>
                    <li>Data Processing & Analyze</li>
                </ul>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
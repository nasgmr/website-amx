<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio 2018 - AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const plane = document.getElementById("paperPlane");
        if (!plane) return;

        const urlParams = new URLSearchParams(window.location.search);
        const direction = urlParams.get('fly'); 

        const isMobile = window.innerWidth <= 768;
        
        const flyRight = isMobile ? [
            { transform: 'translate(-100px, 30px) rotate(15deg)', opacity: 1 },
            { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5 }
        ] : [
            { transform: 'translate(-150px, 30px) rotate(15deg)', opacity: 0, offset: 0 },
            { opacity: 1, offset: 0.1 },
            { opacity: 1, offset: 0.9 },
            { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5, offset: 1 }
        ];

        const flyLeft = isMobile ? [
            { transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 1 },
            { transform: 'translate(-100px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5 }
        ] : [
            { transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 0, offset: 0 },
            { opacity: 1, offset: 0.1 },
            { opacity: 1, offset: 0.9 },
            { transform: 'translate(-150px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5, offset: 1 }
        ];

        const timing = { duration: 1500, easing: 'cubic-bezier(0.25, 1, 0.5, 1)', fill: 'forwards' };

        setTimeout(() => {
            if (direction === 'left') {
                plane.animate(flyLeft, timing);
            } else {
                plane.animate(flyRight, timing); 
            }
        }, 50);

        const currentYearMatch = window.location.pathname.match(/\/portfolio\/(\d{4})/);
        const currentYear = currentYearMatch ? parseInt(currentYearMatch[1]) : 0;
        const links = document.querySelectorAll('.timeline-nav a');

        links.forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault(); 
                let targetHref = this.getAttribute('href').split('?')[0]; 
                
                const targetYearMatch = targetHref.match(/\/portfolio\/(\d{4})/);
                const targetYear = targetYearMatch ? parseInt(targetYearMatch[1]) : 0;

                let flyParam = 'right';
                if (currentYear > 0 && targetYear > 0 && currentYear > targetYear) {
                    flyParam = 'left';
                }

                window.location.href = targetHref + "?fly=" + flyParam;
            });
        });
    });
</script>

<body class="homepage-body portfolio-page">
    <%- include('partials/navbar') %>

    <main class="portfolio-container">
        <img src="/img/paper-plane.png" id="paperPlane" class="flying-plane" alt="Flying Plane">

        <div class="portfolio-header">
            <h1 class="category-main-title">PORTFOLIO</h1> 
        </div>

        <div class="timeline-nav">
            <a href="/about-us/portfolio/2018" class="<%= active === '2018' ? 'active-year' : '' %>">2018</a>
            <a href="/about-us/portfolio/2019" class="<%= active === '2019' ? 'active-year' : '' %>">2019</a>
            <a href="/about-us/portfolio/2020" class="<%= active === '2020' ? 'active-year' : '' %>">2020</a>
            <a href="/about-us/portfolio/2021" class="<%= active === '2021' ? 'active-year' : '' %>">2021</a>
            <a href="/about-us/portfolio/2022" class="<%= active === '2022' ? 'active-year' : '' %>">2022</a>
            <a href="/about-us/portfolio/2023" class="<%= active === '2023' ? 'active-year' : '' %>">2023</a>
            <a href="/about-us/portfolio/2024" class="<%= active === '2024' ? 'active-year' : '' %>">2024</a>
            <a href="/about-us/portfolio/2025" class="<%= active === '2025' ? 'active-year' : '' %>">2025</a>
        </div>

        <div class="portfolio-list">
            <div class="portfolio-item">
                <p>Sumbawa Gold Mine Aerial Mapping, PT Intam, Indonesia</p> 
            </div>
            <div class="portfolio-item">
                <p>Kaligintung Tea Plantation Aerial Mapping, PSN, Indonesia</p> 
            </div>
            <div class="portfolio-item">
                <p>Guwosari Village Aerial Mapping & VR Promotion, UNY, Indonesia</p> 
            </div>
            <div class="portfolio-item">
                <p>Pacarejo Village Aerial Mapping & VR Promotion, UNY, Indonesia</p> 
            </div>
            <div class="portfolio-item">
                <p>Qubit Education Drone Procurement, Smart Extra Aeromodelling-Drone, Indonesia</p> 
            </div>
            <div class="portfolio-item">
                <p>Gamagora 7 Paddy Monitoring, UGM, Indonesia</p> 
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
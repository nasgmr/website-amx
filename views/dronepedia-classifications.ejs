<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dronepedia - Classifications | AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const plane = document.getElementById("paperPlane");
        if (!plane) return;

        const urlParams = new URLSearchParams(window.location.search);
        const direction = urlParams.get('fly'); 

        const isMobile = window.innerWidth <= 768;
        
        const flyRight = isMobile ? [
            { transform: 'translate(-100px, 30px) rotate(15deg)', opacity: 1 },
            { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5 }
        ] : [
            { transform: 'translate(-150px, 30px) rotate(15deg)', opacity: 0, offset: 0 },
            { opacity: 1, offset: 0.1 },
            { opacity: 1, offset: 0.9 },
            { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5, offset: 1 }
        ];

        const flyLeft = isMobile ? [
            { transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 1 },
            { transform: 'translate(-100px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5 }
        ] : [
            { transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 0, offset: 0 },
            { opacity: 1, offset: 0.1 },
            { opacity: 1, offset: 0.9 },
            { transform: 'translate(-150px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5, offset: 1 }
        ];

        const timing = { duration: 1500, easing: 'cubic-bezier(0.25, 1, 0.5, 1)', fill: 'forwards' };

        setTimeout(() => {
            if (direction === 'left') {
                plane.animate(flyLeft, timing);
            } else {
                plane.animate(flyRight, timing); 
            }
        }, 50);

        const order = ['how-it-works', 'classifications', 'applications'];
        const currentPath = window.location.pathname.toLowerCase();
        let currentIndex = order.findIndex(id => currentPath.includes(id));
        if(currentIndex === -1) currentIndex = 0;

        const links = document.querySelectorAll('a');
        links.forEach(link => {
            link.addEventListener('click', function(e) {
                let targetHref = this.getAttribute('href');
                if(!targetHref) return;
                
                let cleanHref = targetHref.split('?')[0];
                let targetIndex = order.findIndex(id => cleanHref.toLowerCase().includes(id));
                
                if (targetIndex !== -1 && cleanHref.includes('/dronepedia/')) {
                    e.preventDefault();
                    let flyParam = (targetIndex < currentIndex) ? 'left' : 'right';
                    window.location.href = cleanHref + "?fly=" + flyParam;
                }
            });
        });
    });
</script>

<body class="homepage-body">
    <%- include('partials/navbar') %>

    <main class="use-case-container">
        <img src="/img/paper-plane.png" id="paperPlane" class="flying-plane" alt="Flying Plane">

        <div class="use-case-header-section">
            <h4 class="use-case-label">DRONEPEDIA</h4>
            <nav class="sub-nav">
                <a href="/products/dronepedia/how-it-works">HOW IT WORKS</a>
                <a href="/products/dronepedia/classifications" class="active">CLASSIFICATION</a>
                <a href="/products/dronepedia/applications">APPLICATIONS</a>
            </nav>
            <h1 class="category-main-title">CLASSIFICATION & COMPARISON</h1>
        </div>

        <div class="dronepedia-content">
            <div class="comparison-grid">
                <div class="drone-type-card">
                    <img src="/img/fixed-wing.png" style="width: 100%; height: 220px; object-fit: contain; object-position: center;" alt="fixed wing drone" class="drone-img-box">
                    <div class="drone-info">
                        <h3>Fixed Wing</h3>
                        <div class="pros-cons-box">
                            <h4 class="pros-title"><i class="fa-solid fa-plus"></i> Advantages</h4>
                            <ul>
                                <li>More flight time compared to rotary wing & hybrid</li>
                                <li>Wide coverage</li>
                                <li>Gliding capability (more safety)</li>
                                <li>High speed</li>
                            </ul>
                        </div>

                        <div class="pros-cons-box">
                            <h4 class="cons-title"><i class="fa-solid fa-minus"></i> Disadvantages</h4>
                            <ul>
                                <li>Wide area for take-off & landing needs</li>
                                <li>Can't hovering</li>
                                <li>Special skills needed</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="drone-type-card">
                    <img src="/img/multicopter.png" style="width: 100%; height: 220px; object-fit: contain; object-position: center;" alt="rotary wing drone" class="drone-img-box">
                    <div class="drone-info">
                        <h3>Rotary Wing</h3>
                        <div class="pros-cons-box">
                            <h4 class="pros-title"><i class="fa-solid fa-plus"></i> Advantages</h4>
                            <ul>
                                <li>Can hovering (hold position)</li>
                                <li>Move to any direction (3D)</li>
                                <li>Easier control than fixed wing</li>
                                <li>Take-off & landing from limited space</li>
                            </ul>
                        </div>

                        <div class="pros-cons-box">
                            <h4 class="cons-title"><i class="fa-solid fa-minus"></i> Disadvantages</h4>
                            <ul>
                                <li>Limited flight time compared to fixed wing and hybrid</li>
                                <li>Limited coverage</li>
                                <li>If there is rotor malfunction, no gliding capability</li>
                                <li>Low speed</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="drone-type-card">
                    <img src="/img/vtol.png" style="width: 100%; height: 220px; object-fit: contain; object-position: center;" alt="hybrid vtol drone" class="drone-img-box">
                    <div class="drone-info">
                        <h3>Hybrid VTOL</h3>
                        <div class="pros-cons-box">
                            <h4 class="pros-title"><i class="fa-solid fa-plus"></i> Advantages</h4>
                            <ul>
                                <li>Easier control than fixed wing</li>
                                <li>More flight time than rotary wing</li>
                                <li>Wider coverage than rotary wing</li>
                                <li>Glide Capability</li>
                            </ul>
                        </div>

                        <div class="pros-cons-box">
                            <h4 class="cons-title"><i class="fa-solid fa-minus"></i> Disadvantages</h4>
                            <ul>
                                <li>Limited flight time compared to fixed wing</li>
                                <li>Higher price compared than fixed wing and rotary wing</li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </main>

    <%- include('partials/footer') %>
</body>

</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Use Case - Tourism | AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="homepage-body">

    <%- include('partials/navbar') %>

    <main class="use-case-container">
        <h4 class="use-case-label">USE CASE</h4>

        <nav class="use-case-nav">
            <a href="/resources/use-case/infrastructure" class="active">INFRASTRUCTURE M.</a>
            <a href="/resources/use-case/tourism">TOURISM PROMO</a>
            <a href="/resources/use-case/agri-forest">AGRICULTURE & FOREST</a>
            <a href="/resources/use-case/agri-plant">AGRICULTURE & PLANTATION</a>
        </nav>

        <h1 class="category-main-title">TOURISM PROMOTION & MINING INVENTORY</h1>

        <div class="case-grid">
            
            <div class="case-item">
                <div class="case-image-placeholder">IMAGE</div>
                <div class="case-info">
                    <h3>Virtual Reality For Tourism Promotion</h3>
                    
                    <div class="case-stats-grid">
                        <div class="stat-item">
                            <label>Location</label>
                            <span>Flores, Indonesia</span>
                        </div>
                        <div class="stat-item">
                            <label>Total Area</label>
                            <span>1000 Ha</span>
                        </div>
                        <div class="stat-item">
                            <label>Altitude</label>
                            <span>200m</span>
                        </div>
                        <div class="stat-item">
                            <label>Drone</label>
                            <span>AMX Vertic</span>
                        </div>
                        <div class="stat-item">
                            <label>GSD</label>
                            <span>7cm/pixel</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="case-item">
                <div class="case-image-placeholder">IMAGE</div>
                <div class="case-info">
                    <h3>Nickel Mine Site Inventory</h3>
                    
                    <div class="case-stats-grid">
                        <div class="stat-item">
                            <label>Location</label>
                            <span>Kolaka, Indonesia</span>
                        </div>
                        <div class="stat-item">
                            <label>Total Area</label>
                            <span>7000 Ha</span>
                        </div>
                        <div class="stat-item">
                            <label>Altitude</label>
                            <span>250m</span>
                        </div>
                        <div class="stat-item">
                            <label>Drone</label>
                            <span>AMX Vertic</span>
                        </div>
                        <div class="stat-item">
                            <label>GSD</label>
                            <span>7cm/pixel</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

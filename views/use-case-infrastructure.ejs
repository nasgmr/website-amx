<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Use Case - Infrastructure | AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="homepage-body">
    <%- include('partials/navbar') %>

    <main class="use-case-container">
        
        <div class="use-case-header-section">
            <h4 class="use-case-label">USE CASE</h4>
            
            <nav class="sub-nav">
                <a href="/use-case/infrastructure" class="active">INFRASTRUCTURE MONITORING</a>
                <a href="/use-case/tourism">TOURISM PROMOTION</a>
                <a href="/use-case/agri-forest">AGRICULTURE & FOREST</a>
                <a href="/use-case/agri-plant">AGRICULTURE & PLANTATION</a>
            </nav>

            <h1 class="category-main-title">INFRASTRUCTURE MONITORING & PLANNING</h1>
        </div>

        <div class="case-grid">
            
            <div class="case-item">
                <h3 class="project-title">Land Use and Industrial Site Planning</h3>
                <div class="case-image-placeholder">IMAGE</div>
                
                <div class="case-stats-grid">
                    <div class="stat-item"><label>Location</label><span>Batam, Indonesia</span></div>
                    <div class="stat-item"><label>Total Area</label><span>400Ha</span></div>
                    <div class="stat-item"><label>Altitude</label><span>200m</span></div>
                    <div class="stat-item"><label>Drone</label><span>AMX Vertic</span></div>
                    <div class="stat-item"><label>GSD</label><span>7cm/pixel</span></div>
                </div>
            </div>

            <div class="case-item">
                <h3 class="project-title">Gas Pipeline Planning</h3>
                <div class="case-image-placeholder">IMAGE</div>
                
                <div class="case-stats-grid">
                    <div class="stat-item"><label>Location</label><span>Kalimantan, Indonesia</span></div>
                    <div class="stat-item"><label>Total Area</label><span>36Km</span></div>
                    <div class="stat-item"><label>Altitude</label><span>300m</span></div>
                    <div class="stat-item"><label>Drone</label><span>AMX Vertic</span></div>
                    <div class="stat-item"><label>GSD</label><span>9cm/pixel</span></div>
                </div>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dronepedia - Applications | AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const plane = document.getElementById("paperPlane");
        if (!plane) return;

        const urlParams = new URLSearchParams(window.location.search);
        const direction = urlParams.get('fly'); 
        const isMobile = window.innerWidth <= 768;
        const timing = { duration: 1500, easing: 'cubic-bezier(0.25, 1, 0.5, 1)', fill: 'forwards' };

        // 1. Animasi Pesawat
        const flyRight = isMobile ? 
            [{ transform: 'translate(-100px, 30px) rotate(15deg)', opacity: 1 }, { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5 }] : 
            [{ transform: 'translate(-150px, 30px) rotate(15deg)', opacity: 0, offset: 0 }, { opacity: 1, offset: 0.1 }, { opacity: 1, offset: 0.9 }, { transform: 'translate(100vw, -50px) rotate(-5deg)', opacity: 0.5, offset: 1 }];

        const flyLeft = isMobile ? 
            [{ transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 1 }, { transform: 'translate(-100px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5 }] : 
            [{ transform: 'translate(100vw, 30px) scaleX(-1) rotate(15deg)', opacity: 0, offset: 0 }, { opacity: 1, offset: 0.1 }, { opacity: 1, offset: 0.9 }, { transform: 'translate(-150px, -50px) scaleX(-1) rotate(-5deg)', opacity: 0.5, offset: 1 }];

        setTimeout(() => {
            direction === 'left' ? plane.animate(flyLeft, timing) : plane.animate(flyRight, timing);
        }, 50);

        // 2. LOGIKA UTAMA (Sesuai Referensi Sukses)
        // Pastikan selector ini (.dronepedia-content) membungkus isi konten di EJS kamu
        const contentContainers = document.querySelectorAll(".dronepedia-content");
        const mainContent = contentContainers.length > 0 ? contentContainers[0] : null;

        if (mainContent) {
            const dragLeftAnim = [{ transform: 'translateX(100vw) scale(0.9) skewX(-5deg)', opacity: 0 }, { transform: 'translateX(-20px) scale(1.02) skewX(2deg)', opacity: 1, offset: 0.8 }, { transform: 'translateX(0) scale(1) skewX(0deg)', opacity: 1 }];
            const dragRightAnim = [{ transform: 'translateX(-100vw) scale(0.9) skewX(5deg)', opacity: 0 }, { transform: 'translateX(20px) scale(1.02) skewX(-2deg)', opacity: 1, offset: 0.8 }, { transform: 'translateX(0) scale(1) skewX(0deg)', opacity: 1 }];

            // Daftarkan elemen yang mau digerakkan (Hanya kontennya, Judul diam)
            const elementsToAnimate = document.querySelectorAll(".dronepedia-content");
            
            elementsToAnimate.forEach(el => {
                if (direction === 'left') {
                    el.animate(dragLeftAnim, timing);
                } else {
                    // DEFAULT: Pas klik dari Navbar atau klik 'right', dia tetep gerak
                    el.animate(dragRightAnim, timing); 
                }
            });
        }

        // 3. Logika Navigasi Sub-Menu Dronepedia
        const order = ['how-it-works', 'classifications', 'applications'];
        const currentPath = window.location.pathname.toLowerCase();
        let findIdx = order.findIndex(id => currentPath.includes(id));
        let currentIndex = findIdx === -1 ? 0 : findIdx;

        document.querySelectorAll('.sub-nav a').forEach(link => {
            link.addEventListener('click', function(e) {
                const targetHref = this.getAttribute('href');
                if (targetHref && targetHref.includes('/dronepedia/')) {
                    e.preventDefault();
                    const cleanHref = targetHref.split('?')[0];
                    const targetIndex = order.findIndex(id => cleanHref.toLowerCase().includes(id));
                    const flyParam = (targetIndex < currentIndex) ? 'left' : 'right';
                    window.location.href = cleanHref + "?fly=" + flyParam;
                }
            });
        });
    });
</script>

<body class="homepage-body">
    <%- include('partials/navbar') %>

    <main class="use-case-container">
        <img src="/img/DRONE - ANIMATION.png" id="paperPlane" class="flying-plane" alt="Flying Plane">
        
        <div class="use-case-header-section">
            <h4 class="use-case-label" style="font-weight: 600;">DRONEPEDIA</h4>
            <nav class="sub-nav">
                <a href="/products/dronepedia/how-it-works">HOW IT WORKS</a>
                <a href="/products/dronepedia/classifications">CLASSIFICATION</a>
                <a href="/products/dronepedia/applications" class="active">APPLICATIONS</a>
            </nav>
            <h1 class="category-main-title">DRONE APPLICATIONS</h1>
        </div>

        <div class="dronepedia-content">
            <div class="applications-grid">
                <div class="app-card">
                    <img src="/img/aerial videography & photography.png" style="width: 100%; height: 220px; object-fit: contain; object-position: center;" alt="aerial videography & photography" class="app-img-box">
                    <div class="app-title-box">
                        <h3>Aerial Videography & Photography</h3>
                    </div>
                </div>

                <div class="app-card">
                    <img src="/img/land mapped.png" style="width: 100%; height: 220px; object-fit: contain; object-position: center;" alt="land mapping" class="app-img-box">
                    <div class="app-title-box">
                        <h3>Land Mapping</h3>
                    </div>
                </div>

                <div class="app-card">
                    <img src="/img/agriculture & environment management.png" style="width: 100%; height: 220px; object-fit: contain; object-position: center;" alt="agriculture & environment management" class="app-img-box">
                    <div class="app-title-box">
                        <h3>Agriculture & Environment Management</h3>
                    </div>
                </div>

                <div class="app-card">
                    <img src="/img/construction & engineer planning.png" style="width: 100%; height: 220px; object-fit: contain; object-position: center;" alt="construction & engineering planning" class="app-img-box">
                    <div class="app-title-box">
                        <h3>Construction & Engineering Planning</h3>
                    </div>
                </div>

                <div class="app-card">
                    <img src="/img/disaster management.png" style="width: 100%; height: 220px; object-fit: contain; object-position: center;" alt="disaster management" class="app-img-box">
                    <div class="app-title-box">
                        <h3>Disaster Management</h3>
                    </div>
                </div>

                <div class="app-card">
                    <img src="/img/education & hobby.png" style="width: 100%; height: 220px; object-fit: contain; object-position: center;" alt="education & hobby" class="app-img-box">
                    <div class="app-title-box">
                        <h3>Education & Hobby</h3>
                    </div>
                </div>

            </div>
        </div>

    </main>

    <%- include('partials/footer') %>
</body>

</html>
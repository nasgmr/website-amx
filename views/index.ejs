<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AMX UAV - Drone Solution</title>
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="homepage-body">
    <%- include('partials/navbar') %>

    <main class="hero-section">
        <h1 class="glowing-text">DRONE SOLUTION FOR INDUSTRY 5.0</h1>
        <p>AMX UAV offer mapping drone and services for various industry</p>
        <a href="https://drive.google.com/file/d/1APSnKeG_bUYtVmAfQr0WhkKxK9-ws2O9/view?usp=sharing" target="_blank" class="btn-learn-more">Learn More</a>
        <div class="social-icons">
            <a href="https://www.instagram.com/amx.uav" target="_blank" class="social-link"><i class="fab fa-instagram"></i></a>
            <a href="https://www.facebook.com/amx.uav/" target="_blank" class="social-link"><i class="fab fa-facebook-f"></i></a>
            <a href="https://linkedin.com/company/amxuav" target="_blank" class="social-link"><i class="fab fa-linkedin-in"></i></a>
            <a href="https://www.youtube.com/@amxuav2935" target="_blank" class="social-link"><i class="fab fa-youtube"></i></a>
        </div>
    </main>

    <section class="hp-product-highlight">
    <div class="hp-highlight-container">
        <div class="hp-mobile-title-area">
            <h4 class="hp-category-label">Compact eVTOL Drone</h4>
            <h1 class="hp-main-title">VERTIC AIR</h1>
        </div>

        <div class="hp-highlight-media">
            <div class="hp-placeholder-box">
            </div>
        </div>

        <div class="hp-highlight-info">
            <p class="hp-main-desc">
                Vertic Air is easy to control, fully autonomous, and capable to operate from narrow vertical take off-landing (VTOL) mapping drone.
            </p>
            <ul class="hp-feature-list">
                <li><i class="fas fa-check-circle"></i> Vertical Take-Off Landing</li>
                <li><i class="fas fa-check-circle"></i> Fully autonomous mission</li>
                <li><i class="fas fa-check-circle"></i> 40 minutes flight time</li>
                <li><i class="fas fa-check-circle"></i> Wind Resist 14m/s (fixed wing) & 9m/s (copter)</li>
                <li><i class="fas fa-check-circle"></i> Light and Strong Composites Material</li>
                <li><i class="fas fa-check-circle"></i> PPK Ready</li>
                <li><i class="fas fa-check-circle"></i> RGB and Multispectral Camera Payload</li>
            </ul>
            
            <div class="hp-btn-footer-mobile">
                <a href="/products" class="hp-btn-see-more">See More Products</a>
            </div>
        </div>
    </div>
    </section>

    <section class="hp-video-section">
        <div class="hp-video-wrapper">
            <iframe src="https://www.youtube-nocookie.com/embed/jQkANpci7Aw?rel=0" frameborder="0" allowfullscreen></iframe>
        </div>
    </section>

    <section class="hp-basic-articles-section">
        <h1 class="hp-section-title" style="font-size: 35px"> Whether starting out or scaling up <br> —AMX UAV delivers precision data, simplified.</h1>
        <div class="hp-basic-articles-list">
            <a href="/products/dronepedia/how-it-works" class="hp-basic-articles-card-list">
                <div class="hp-basic-card-list-text">
                    <h3 class="hp-basic-article-title">New to Aerial Surveying?</h3>
                    <p class="hp-excerpt">Discover a seamless end-to-end workflow designed to take your operations from the ground to the sky with ease.</p>
                </div>
                <div class="hp-basic-card-list-img"><img src="/img/AMX-GCS.jpg" alt=""></div>
            </a>

            <a href="/products/vertic-xl" class="hp-basic-articles-card-list">
                <div class="hp-basic-card-list-text">
                    <h3 class="hp-basic-article-title">Already Flying?</h3>
                    <p class="hp-excerpt">Elevate your results with Vertic XL. Our flagship eVTOL is engineered for long-range missions and total data confidence.</p>
                </div>
                <div class="hp-basic-card-list-img"><img src="/img/AMX-GCS.jpg" alt=""></div>
            </a>
        </div>
    </section>

    <section class="hp-articles-section">
        <h1 class="hp-section-title">OUR WORKS</h1>
        <div class="hp-articles-list">
            <% for(let i=1; i<=3; i++) { %>
            <div class="hp-card-list">
                <div class="hp-card-list-text">
                    <h3 class="hp-article-title">Title Article <%= i %></h3>
                    <p class="hp-excerpt">Brief information of the article content that makes users interested in reading more.</p>
                    <a href="/about-us/articles/detail" class="hp-btn-read">Read More</a>
                </div>
                <div class="hp-card-list-img"><img src="/img/AMX-GCS.jpg" alt=""></div>
            </div>
            <% } %>
        </div>
        <div class="hp-action-center">
            <a href="/about-us/articles" class="btn-see-more-yellow">See More</a>
        </div>
    </section>

    <section class="hp-gallery-section">
        <h1 class="hp-section-title">OUR GALLERY</h1>
        <div class="hp-gallery-container">
            <div class="hp-arrow" id="prevBtn"><i class="fas fa-caret-left"></i></div>
            
            <div class="hp-gallery-track">
                <div class="hp-frame hp-slider-node pos-left"><img src="/img/Use Case - Land Use.png"></div>
                <div class="hp-frame hp-slider-node pos-center"><img src="/img/Use Case - Soil Moisture.png"></div>
                <div class="hp-frame hp-slider-node pos-right"><img src="/img/Use Case - Irrigation Modelling.png"></div>
            </div>

            <div class="hp-arrow" id="nextBtn"><i class="fas fa-caret-right"></i></div>
        </div>
    </section>

    <%- include('partials/footer') %>

    <script>
        const nodes = document.querySelectorAll('.hp-slider-node');
        const nextBtn = document.getElementById('nextBtn');
        const prevBtn = document.getElementById('prevBtn');

        let currentClasses = ['pos-left', 'pos-center', 'pos-right'];

        function applyRotation() {
            nodes.forEach((node, i) => {
                node.classList.remove('pos-left', 'pos-center', 'pos-right');
                node.classList.add(currentClasses[i]);
            });
        }

        if(nextBtn) {
            nextBtn.addEventListener('click', () => {
                currentClasses.unshift(currentClasses.pop());
                applyRotation();
            });
        }

        if(prevBtn) {
            prevBtn.addEventListener('click', () => {
                currentClasses.push(currentClasses.shift());
                applyRotation();
            });
        }
    </script>
</body>
</html>
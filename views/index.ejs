<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AMX UAV - Drone Solution</title>
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="homepage-body">
    <%- include('partials/navbar') %>

    <main class="hero-section">
        <h1>DRONE SOLUTION FOR INDUSTRY 5.0</h1>
        <p>AMX UAV offer mapping drone and services for various industry</p>
        <a href="https://drive.google.com/file/d/1APSnKeG_bUYtVmAfQr0WhkKxK9-ws2O9/view?usp=sharing" target="_blank" class="btn-learn-more">Learn More</a>
        <div class="social-icons">
            <a href="https://www.instagram.com/amx.uav" target="_blank" class="social-link"><i class="fab fa-instagram"></i></a>
            <a href="https://www.facebook.com/amx.uav/" target="_blank" class="social-link"><i class="fab fa-facebook-f"></i></a>
            <a href="https://linkedin.com/company/amxuav" target="_blank" class="social-link"><i class="fab fa-linkedin-in"></i></a>
            <a href="https://www.youtube.com/@amxuav2935" target="_blank" class="social-link"><i class="fab fa-youtube"></i></a>
        </div>
    </main>

    <section class="hp-product-highlight">
        <div class="hp-highlight-container">
            <div class="hp-highlight-info">
                <h4 class="hp-category-label">Compact eVTOL Drone</h4>
                <h1 class="hp-main-title glowing-text">VERTIC AIR</h1>
                <p class="hp-main-desc">
                    Vertic Air is easy to control, fully autonomous, and capable to operate from narrow vertical take off-landing (VTOL) mapping drone. Vertic air is ready for various application such as agriculture, asset monitoring, construction & engineering planning, and military surveillance.
                </p>
                <ul class="hp-feature-list">
                    <li><i class="fas fa-check-circle"></i> Vertical Take-Off Landing</li>
                    <li><i class="fas fa-check-circle"></i> Fully autonomous mission</li>
                    <li><i class="fas fa-check-circle"></i> 60+ minutes flight time</li>
                    <li><i class="fas fa-check-circle"></i> Light and strong composite material</li>
                </ul>
            </div>

            <div class="hp-highlight-media">
                <div class="hp-placeholder-box">
                    <span>FOTO PRODUK VERTIC AIR</span>
                </div>
                <a href="/products" class="hp-btn-see-more">See More</a>
            </div>
        </div>
    </section>

    <section class="hp-video-section">
        <div class="hp-video-wrapper">
            <iframe src="https://www.youtube-nocookie.com/embed/jQkANpci7Aw" frameborder="0" allowfullscreen></iframe>
        </div>
    </section>

    <section class="hp-articles-section">
        <h1 class="hp-section-title">LATEST ARTICLES</h1>
        <div class="hp-articles-list">
            <% for(let i=1; i<=3; i++) { %>
            <div class="hp-card-list">
                <div class="hp-card-list-text">
                    <h3 class="hp-article-title">Title Article <%= i %></h3>
                    <div class="hp-meta">
                        <span><i class="fas fa-user"></i> AMX UAV</span>
                        <span><i class="fas fa-calendar"></i> Released Date</span>
                    </div>
                    <p class="hp-excerpt">Brief information of the article contentthat makes users interested in reading more.</p>
                    <a href="#" class="hp-btn-read">Read More</a>
                </div>
                <div class="hp-card-list-img">
                    <img src="/img/article-sample-<%= i %>.jpg" alt="">
                </div>
            </div>
            <% } %>
        </div>
        <div class="hp-action-center">
            <a href="/about-us/articles" class="btn-see-more-yellow">See More</a>
        </div>
    </section>

    <section class="hp-gallery-section">
    <h1 class="hp-section-title">OUR GALLERY</h1>
        <div class="hp-gallery-container">
            <div class="hp-arrow" id="prevBtn"><i class="fas fa-caret-left"></i></div>
            
            <div class="hp-gallery-frames" id="gallery-track">
                <div class="hp-frame hp-side" id="frame-left"><img src="/img/gall-1.jpg"></div>
                <div class="hp-frame hp-center" id="frame-center"><img src="/img/gall-2.jpg"></div>
                <div class="hp-frame hp-side" id="frame-right"><img src="/img/gall-3.jpg"></div>
            </div>

            <div class="hp-arrow" id="nextBtn"><i class="fas fa-caret-right"></i></div>
    </div>
    </section>

    <%- include('partials/footer') %>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vertic XL - AMX UAV</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="homepage-body">

    <%- include('partials/navbar') %>

    <main class="detail-container">
        <section class="detail-header">
            <h4 class="product-category">Multipurpose eVTOL Drone</h4>
            <h1 class="product-title glowing-text">VERTIC XL</h1>
        </section>

        <div class="detail-grid">
            <div class="detail-image-box">
                <p>FOTO PRODUK VERTIC XL</p>
            </div>

            <div class="detail-description">
                <p>Vertic XL is quad tail-sitter vertical take off-landing (VTOL) mapping drone that easy to control, fully autonomous, and capable operate from narrow site. Vertic is ready for various application such as agriculture, urban planning, plantation, mining, forestry, and oil & gas.</p>
                
                <div class="specs-grid">
                    <div class="specs-column">
                        <div class="spec-item">
                            <h3>Dimension</h3>
                            <ul>
                                <li>Wingspan: 2400 mm</li>
                                <li>Weight: 7500 gr</li>
                            </ul>
                        </div>

                        <div class="spec-item">
                            <h3>Material</h3>
                            <p>Fiber Composites</p>
                        </div>
                    </div>

                    <div class="specs-column">
                        <div class="spec-item">
                            <h3>More Details</h3>
                            <ul>
                                <li><strong>Payload:</strong> 1000 Grams</li>
                                <li><strong>Flight Time:</strong> 70 Minutes</li>
                                <li><strong>Mapping Area:</strong> 600 Ha</li>
                                <li><strong>Cruise Speed:</strong> 19m/s</li>
                                <li><strong>Flight Range:</strong> 65KM</li>
                            </ul>
                        </div>
                    </div>
                </div> </div> </div> <section class="additional-info">
            <div class="info-box">
                <h3>Mapping Payloads</h3>
                <ul>
                    <li><strong>Map 24 RGB Camera</strong></li>
                    <li><strong>RedEdge-P Multispectral Camera</strong></li>
                    <li><strong>ADTi 26S V2 RGB Camera</strong></li>
                    <li><strong>ILX-LRI RGB Camera</strong></li>
                    <li><strong>Surveyor Ultra Lidar</strong></li>
                </ul>
            </div>

            <div class="info-box">
                <h3>Surveillance Payloads</h3>
                <ul>
                    <li><strong>M3-D Surveillance Camera</strong></li>
                    <li><strong>IR Surveillance Camera</strong></li>
                </ul>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

</body>
</html>